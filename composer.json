{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bokshorn-it/filament-self-updater",
    "description": "A Filament plugin that updates a Laravel application from its own GitHub repository: finds the newest tag or release, installs it through a queued job, removes files the release dropped and runs a post-update script.",
    "keywords": [
        "laravel",
        "filamentphp",
        "filament",
        "filament-plugin",
        "self-update",
        "updater",
        "github"
    ],
    "homepage": "https://bokshorn.it",
    "license": "MIT",
    "authors": [
        {
            "name": "Johannes Bokshorn",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Bokshorn-IT/filament-self-updater/issues",
        "source": "https://github.com/Bokshorn-IT/filament-self-updater",
        "security": "https://github.com/Bokshorn-IT/filament-self-updater/security/policy"
    },
    "require": {
        "php": "^8.3",
        "ext-zip": "*",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.92"
    },
    "require-dev": {
        "laravel/pint": "^1.27",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "BokshornIt\\FilamentSelfUpdater\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BokshornIt\\FilamentSelfUpdater\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "test": "vendor/bin/pest",
        "test:lint": "vendor/bin/pint --test",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "BokshornIt\\FilamentSelfUpdater\\FilamentSelfUpdaterServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
